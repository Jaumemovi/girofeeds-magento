?>
<?php if ($feedData = $block->getFeedData()): ?>
    <div class="mm-block-girofeeds-feeds">
        <span class="title">
            <?= $block->escapeHTML(__('Feed Endpoints')); ?>
        </span>

        <div class="description">
            <?= $block->escapeHTML(__('Each store view has its own product feed endpoint. Use the JSON link to access the feed data.')); ?>
        </div>

        <div class="mm-block-ui-feed">
            <?php foreach ($feedData as $data): ?>
                <div class="item">
                    <div class="store-info">
                        <span class="left"><?= $block->escapeHTML($data['name']); ?></span>
                        <span class="right">( <?= $block->escapeHTML($data['code']); ?> )</span>
