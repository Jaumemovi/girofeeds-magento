<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="girofeeds_api_log" resource="default" engine="innodb" comment="Girofeeds API Request Log">
        <column name="entity_id" xsi:type="int" padding="10" identity="true" nullable="false" unsigned="true" comment="Entity ID"/>
        <column name="timestamp" xsi:type="timestamp" on_update="false" default="CURRENT_TIMESTAMP" comment="Request Timestamp"/>
        <column name="ip_address" xsi:type="varchar" length="45" nullable="true" comment="Client IP Address"/>
        <column name="endpoint" xsi:type="varchar" length="255" nullable="true" comment="API Endpoint"/>
        <column name="api_key_hash" xsi:type="varchar" length="8" nullable="true" comment="API Key Hash (first 8 chars)"/>
        <column name="response_status" xsi:type="smallint" padding="5" unsigned="true" nullable="true" comment="HTTP Response Status"/>
        <column name="execution_time_ms" xsi:type="int" padding="10" unsigned="true" nullable="true" comment="Execution Time in Milliseconds"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="GIROFEEDS_API_LOG_TIMESTAMP" indexType="btree">
            <column name="timestamp"/>
        </index>
    </table>
</schema>
