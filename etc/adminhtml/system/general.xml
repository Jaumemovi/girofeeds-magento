<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <section id="girofeeds_productapi" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>General Settings</label>
        <tab>girofeeds</tab>
        <resource>Girofeeds_ProductApi::config</resource>
        <group id="connection" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Connection Info</label>
            <comment><![CDATA[Use the values below to connect this store in the Girofeeds application.]]></comment>
            <attribute type="expanded">1</attribute>
            <field id="store_domain" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Store Domain</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\System\Config\Form\Field\StoreDomain</frontend_model>
                <comment><![CDATA[Base URL of this store. Copy this value into the <strong>Store Domain</strong> field in Girofeeds.]]></comment>
            </field>
            <field id="api_key" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>API Key</label>
                <config_path>girofeeds_productapi/general/api_key</config_path>
                <comment><![CDATA[Copy this value into the <strong>API Key</strong> field in Girofeeds. To regenerate, run: <code>bin/magento girofeeds:token:generate --force=1</code>]]></comment>
            </field>
            <field id="module_version" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Module Version</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\System\Config\Form\Field\ModuleVersion</frontend_model>
                <comment><![CDATA[Copy this value into the <strong>Module Version</strong> field in Girofeeds.]]></comment>
            </field>
            <field id="store_views" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Store Views</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\System\Config\Form\Field\StoreViews</frontend_model>
                <comment><![CDATA[Available store view codes. Use the desired code in the <strong>Store View</strong> field in Girofeeds.]]></comment>
            </field>
        </group>
        <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>General</label>
            <attribute type="expanded">1</attribute>
            <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable Module</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/general/enable</config_path>
            </field>
            <field id="limit" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Products Per Page</label>
                <config_path>girofeeds_productapi/general/limit</config_path>
                <validate>validate-digits</validate>
                <comment>Maximum number of products returned per API request. Default: 100</comment>
            </field>
            <field id="add_disabled" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Include Disabled Products</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/general/add_disabled</config_path>
            </field>
            <field id="stock" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Include Out of Stock</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/general/stock</config_path>
            </field>
            <!-- Default scope only: RateLimiter reads this path without a store scope. -->
            <field id="rate_limit" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>API Rate Limit</label>
                <config_path>girofeeds_productapi/general/rate_limit</config_path>
                <validate>validate-digits validate-greater-than-zero</validate>
                <comment>Maximum number of API requests accepted per minute for each API key. Requests above the limit are rejected with HTTP 429. Default: 600</comment>
            </field>
            <!-- Default scope only: UpdateProduct reads this path without a store scope. -->
            <field id="write_scope" translate="label comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Write Scope</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\WriteScope</source_model>
                <config_path>girofeeds_productapi/general/write_scope</config_path>
                <comment><![CDATA[Where product updates from Girofeeds are written. <strong>All Store Views</strong> (store_id 0, recommended) writes the default values whatever the REST route store view is. Choose a store view only to write values specific to that view. A request can still override it with the <code>store</code> parameter or the <code>store_id</code> payload field.]]></comment>
            </field>
        </group>
        <!-- Default scope only: CreateProduct reads these paths without a store scope (products are created at store_id 0). -->
        <group id="create" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Product Creation</label>
            <comment><![CDATA[Default values applied when Girofeeds creates a new product in this store. Products are always created as simple products with values for All Store Views (store_id 0).]]></comment>
            <field id="attribute_set" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Attribute Set</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\AttributeSets</source_model>
                <config_path>girofeeds_productapi/create/attribute_set</config_path>
                <comment>Attribute set assigned to products created from Girofeeds. Default: Default (ID 4)</comment>
            </field>
            <field id="website_ids" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Website IDs</label>
                <config_path>girofeeds_productapi/create/website_ids</config_path>
                <comment>Comma-separated website IDs the new products are assigned to (for example: 1,2). Leave empty to use the website of the default store view.</comment>
            </field>
            <field id="tax_class_id" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Tax Class</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\TaxClasses</source_model>
                <config_path>girofeeds_productapi/create/tax_class_id</config_path>
                <comment>Product tax class assigned to products created from Girofeeds. Default: Taxable Goods (ID 2)</comment>
            </field>
            <field id="visibility" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Visibility</label>
                <source_model>Magento\Catalog\Model\Product\Visibility</source_model>
                <config_path>girofeeds_productapi/create/visibility</config_path>
                <comment>Visibility assigned to products created from Girofeeds. Default: Catalog, Search</comment>
            </field>
        </group>
        <group id="debug" translate="label" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Debug &amp; Logging</label>
            <field id="debug" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Debug Mode</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/general/debug</config_path>
                <comment><![CDATA[Enable to write debug records into <code>var/log/girofeeds/debug.log</code>. Errors are always logged in <code>var/log/girofeeds/error.log</code>.]]></comment>
            </field>
        </group>
    </section>
</include>
