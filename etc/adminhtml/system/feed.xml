<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <section id="girofeeds_feed" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Product Feed</label>
        <tab>girofeeds</tab>
        <resource>Girofeeds_ProductApi::config</resource>
        <group id="branding" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Branding</label>
            <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Header</frontend_model>
        </group>

        <group id="data" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Data Settings</label>
            <comment>Connect the right attributes for the basic product values to the feed.</comment>
            <field id="name_attribute" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Name</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/name_attribute</config_path>
                <comment>Select the attribute for the product name.</comment>
            </field>
            <field id="description_attribute" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Description</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/description_attribute</config_path>
                <comment>Select the attribute for the product description.</comment>
            </field>
            <field id="short_description_attribute" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Short Description</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/short_description_attribute</config_path>
                <comment>Select the attribute for the short description.</comment>
            </field>
            <field id="brand_attribute" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Brand</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/brand_attribute</config_path>
            </field>
            <field id="ean_attribute" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>EAN / GTIN</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/ean_attribute</config_path>
            </field>
            <field id="sku_attribute" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SKU</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/sku_attribute</config_path>
            </field>
            <field id="color_attribute" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Color</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/color_attribute</config_path>
            </field>
            <field id="size_attribute" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Size</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/size_attribute</config_path>
            </field>
            <field id="material_attribute" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Material</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/material_attribute</config_path>
            </field>
            <field id="gender_attribute" translate="label" type="select" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Gender</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Attributes</source_model>
                <config_path>girofeeds_productapi/data/gender_attribute</config_path>
            </field>
        </group>

        <group id="images" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Image Settings</label>
            <field id="image" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Image Source</label>
                <config_path>girofeeds_productapi/data/image</config_path>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\ImageSource</source_model>
            </field>
            <field id="main_image" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Main Image Role</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\MainImage</source_model>
                <config_path>girofeeds_productapi/data/main_image</config_path>
                <comment>Select the source for the main image; other images will be exported as additional images.</comment>
                <depends>
                    <field id="image">all</field>
                </depends>
            </field>
            <field id="hidden_images" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Include Hidden Images</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/data/hidden_images</config_path>
                <depends>
                    <field id="image">all</field>
                </depends>
            </field>
        </group>

        <group id="price" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Price Settings</label>
            <field id="tax" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Tax Calculation</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Tax</source_model>
                <config_path>girofeeds_productapi/advanced/tax</config_path>
            </field>
            <field id="tax_include_both" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Include Both Tax Variants</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/advanced/tax_include_both</config_path>
                <comment>Include prices both with and without tax in the feed output.</comment>
            </field>
        </group>

        <group id="types" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Types</label>
            <comment><![CDATA[Configure how different product types are exported in the feed.]]></comment>

            <field id="heading_configurable" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Configurable Products</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
                <comment><![CDATA[For configurable products, we recommend exporting only the simple products as they represent the purchasable product variants.]]></comment>
            </field>
            <field id="configurable" translate="label" type="select" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Export Type</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Configurable\Option</source_model>
                <config_path>girofeeds_productapi/types/configurable</config_path>
            </field>
            <field id="configurable_link" translate="label" type="select" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent URL for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Configurable\Link</source_model>
                <config_path>girofeeds_productapi/types/configurable_link</config_path>
                <depends>
                    <field id="configurable" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="configurable_image" translate="label" type="select" sortOrder="13" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent Image for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Configurable\Image</source_model>
                <config_path>girofeeds_productapi/types/configurable_image</config_path>
                <depends>
                    <field id="configurable" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="configurable_parent_atts" translate="label" type="multiselect" sortOrder="14" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Parent Data Fallback Fields</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Configurable\ParentAttributes</source_model>
                <config_path>girofeeds_productapi/types/configurable_parent_atts</config_path>
                <depends>
                    <field id="configurable" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="configurable_nonvisible" translate="label" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Fallback only on Non Visible Simples</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/types/configurable_nonvisible</config_path>
                <depends>
                    <field id="configurable" separator=",">simple,both</field>
                </depends>
            </field>

            <field id="heading_bundle" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Bundle Products</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
                <comment><![CDATA[For Bundle Products, we recommend exporting only the bundle product itself.]]></comment>
            </field>
            <field id="bundle" translate="label" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Export Type</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Bundle\Option</source_model>
                <config_path>girofeeds_productapi/types/bundle</config_path>
            </field>
            <field id="bundle_link" translate="label" type="select" sortOrder="22" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent URL for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Bundle\Link</source_model>
                <config_path>girofeeds_productapi/types/bundle_link</config_path>
                <depends>
                    <field id="bundle" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="bundle_image" translate="label" type="select" sortOrder="23" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent Image for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Bundle\Image</source_model>
                <config_path>girofeeds_productapi/types/bundle_image</config_path>
                <depends>
                    <field id="bundle" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="bundle_parent_atts" translate="label" type="multiselect" sortOrder="24" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Parent Data Fallback Fields</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Bundle\ParentAttributes</source_model>
                <config_path>girofeeds_productapi/types/bundle_parent_atts</config_path>
                <depends>
                    <field id="bundle" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="bundle_nonvisible" translate="label" type="select" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Fallback only on Non Visible Simples</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/types/bundle_nonvisible</config_path>
                <depends>
                    <field id="bundle" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="bundle_stock_calculation" translate="label comment" type="select" sortOrder="26" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable Bundle Stock Calculation</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/types/bundle_stock_calculation</config_path>
                <comment><![CDATA[Calculate stock based on the lowest available stock of associated simple products.]]></comment>
                <depends>
                    <field id="bundle" separator=",">parent,both</field>
                </depends>
            </field>

            <field id="heading_grouped" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Grouped Products</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
                <comment><![CDATA[For Grouped Products, we recommend exporting only the grouped product itself.]]></comment>
            </field>
            <field id="grouped" translate="label" type="select" sortOrder="31" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Export Type</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Grouped\Option</source_model>
                <config_path>girofeeds_productapi/types/grouped</config_path>
            </field>
            <field id="grouped_link" translate="label" type="select" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent URL for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Grouped\Link</source_model>
                <config_path>girofeeds_productapi/types/grouped_link</config_path>
                <depends>
                    <field id="grouped" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="grouped_image" translate="label" type="select" sortOrder="33" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Parent Image for Simples</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Grouped\Image</source_model>
                <config_path>girofeeds_productapi/types/grouped_image</config_path>
                <depends>
                    <field id="grouped" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="grouped_parent_price" translate="label" type="select" sortOrder="34" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Parent Price</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Grouped\Price</source_model>
                <config_path>girofeeds_productapi/types/grouped_parent_price</config_path>
                <depends>
                    <field id="grouped" separator=",">parent,both</field>
                </depends>
            </field>
            <field id="grouped_parent_atts" translate="label" type="multiselect" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Parent Data Fallback Fields</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Grouped\ParentAttributes</source_model>
                <config_path>girofeeds_productapi/types/grouped_parent_atts</config_path>
                <depends>
                    <field id="grouped" separator=",">simple,both</field>
                </depends>
            </field>
            <field id="grouped_nonvisible" translate="label" type="select" sortOrder="36" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Fallback only on Non Visible Simples</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/types/grouped_nonvisible</config_path>
                <depends>
                    <field id="grouped" separator=",">simple,both</field>
                </depends>
            </field>
        </group>

        <group id="extra_fields" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Extra Attribute Mappings</label>
            <comment>Add custom attribute mappings to enrich your product data in the feed.</comment>
            <field id="extra_fields" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Extra Fields</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\System\Config\Form\Field\ExtraFields</frontend_model>
                <backend_model>Girofeeds\ProductApi\Model\Config\Backend\Serialized\ExtraFields</backend_model>
                <config_path>girofeeds_productapi/advanced/extra_fields</config_path>
            </field>
        </group>

        <group id="filter" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Filter Settings</label>
            <comment>Include or exclude products from the feed based on visibility, category, or stock.</comment>
            <field id="heading_visibility" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Filter by Visibility</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
            </field>
            <field id="visibility_enabled" translate="label" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/filter/visibility_enabled</config_path>
            </field>
            <field id="visibility" translate="label" type="multiselect" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Allowed Visibility</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\ProductVisibility</source_model>
                <config_path>girofeeds_productapi/filter/visibility</config_path>
                <depends>
                    <field id="visibility_enabled">1</field>
                </depends>
            </field>
            <field id="heading_category" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Filter by Category</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
            </field>
            <field id="category_enabled" translate="label" type="select" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/filter/category_enabled</config_path>
            </field>
            <field id="category_type" translate="label" type="select" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Filter Type</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\CategoryTypeList</source_model>
                <config_path>girofeeds_productapi/filter/category_type</config_path>
                <depends>
                    <field id="category_enabled">1</field>
                </depends>
            </field>
            <field id="category" translate="label" type="multiselect" sortOrder="13" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Categories</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\CategoryList</source_model>
                <config_path>girofeeds_productapi/filter/category</config_path>
                <depends>
                    <field id="category_enabled">1</field>
                </depends>
            </field>
            <field id="heading_stock" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Exclude Out of Stock</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
            </field>
            <field id="stock" translate="label" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/filter/stock</config_path>
            </field>
            <field id="heading_advanced" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Advanced Filters</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
            </field>
            <field id="filters" translate="label" type="select" sortOrder="31" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enabled</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/filter/filters</config_path>
            </field>
            <field id="filters_data" translate="label" type="select" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Filter Conditions</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\System\Config\Form\Field\Filters</frontend_model>
                <backend_model>Girofeeds\ProductApi\Model\Config\Backend\Serialized\Filters</backend_model>
                <config_path>girofeeds_productapi/filter/filters_data</config_path>
                <depends>
                    <field id="filters">1</field>
                </depends>
            </field>
        </group>

        <group id="advanced" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Advanced Options</label>
            <field id="heading_stock" translate="label comment" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Inventory Data</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
                <comment>Select the inventory data fields to export in the feed.</comment>
            </field>
            <field id="inventory" translate="label" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enabled</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/advanced/inventory</config_path>
            </field>
            <field id="inventory_fields" translate="label" type="multiselect" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Fields</label>
                <source_model>Girofeeds\ProductApi\Model\System\Config\Source\Inventory</source_model>
                <config_path>girofeeds_productapi/advanced/inventory_fields</config_path>
                <depends>
                    <field id="inventory">1</field>
                </depends>
            </field>
            <field id="force_non_msi" translate="label comment" type="select" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                <label>Force NON-MSI</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/advanced/force_non_msi</config_path>
                <comment><![CDATA[Force legacy stock QTY ignoring Reservation and Salable QTY. Only use if not using MSI.]]></comment>
                <depends>
                    <field id="inventory">1</field>
                </depends>
            </field>
            <field id="inventory_source_items" translate="label" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                <label>Include Inventory Sources</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/advanced/inventory_source_items</config_path>
                <depends>
                    <field id="inventory">1</field>
                </depends>
            </field>
            <field id="heading_content_staging" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Content Staging</label>
                <frontend_model>Girofeeds\ProductApi\Block\Adminhtml\Design\Heading</frontend_model>
            </field>
            <field id="use_row_id" translate="label comment" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Use Row ID for Simple/Parent relations</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <config_path>girofeeds_productapi/advanced/use_row_id</config_path>
                <comment>Experimental: only enable if simple/parent relations are out of sync (Magento Commerce).</comment>
            </field>
        </group>

