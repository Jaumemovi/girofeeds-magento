<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Girofeeds\ProductApi\Api\Config\RepositoryInterface"
                type="Girofeeds\ProductApi\Model\Config\Repository"/>
    <preference for="Girofeeds\ProductApi\Api\Log\RepositoryInterface"
                type="Girofeeds\ProductApi\Model\Log\Repository"/>
    <preference for="Girofeeds\ProductApi\Api\UpdateProductInterface"
                type="Girofeeds\ProductApi\Model\UpdateProduct"/>
    <preference for="Girofeeds\ProductApi\Api\CountInterface"
                type="Girofeeds\ProductApi\Model\Count"/>
    <preference for="Girofeeds\ProductApi\Api\TestInterface"
                type="Girofeeds\ProductApi\Model\Test"/>
    <preference for="Girofeeds\ProductApi\Api\AttributesInterface"
                type="Girofeeds\ProductApi\Model\Attributes"/>
    <preference for="Girofeeds\ProductApi\Api\FeedInterface"
                type="Girofeeds\ProductApi\Model\Feed"/>

    <type name="Girofeeds\ProductApi\Logger\ErrorLogger">
        <arguments>
            <argument name="name" xsi:type="string">GirofeedsError</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Girofeeds\ProductApi\Logger\Handler\Error</item>
            </argument>
        </arguments>
    </type>
    <type name="Girofeeds\ProductApi\Logger\DebugLogger">
        <arguments>
            <argument name="name" xsi:type="string">GirofeedsDebug</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Girofeeds\ProductApi\Logger\Handler\Debug</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\App\Request\CsrfValidator">
        <plugin name="girofeeds_skip_csrf_validator" type="Girofeeds\ProductApi\Plugin\AroundCsrfValidator"/>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="GirofeedsGenerateToken" xsi:type="object">Girofeeds\ProductApi\Console\Command\GenerateToken</item>
                <item name="GirofeedsSelftest" xsi:type="object">Girofeeds\ProductApi\Console\Command\Selftest</item>
                <item name="GirofeedsScopeRepair" xsi:type="object">Girofeeds\ProductApi\Console\Command\ScopeRepair</item>
                <item name="GirofeedsScopeRestore" xsi:type="object">Girofeeds\ProductApi\Console\Command\ScopeRestore</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="environment" xsi:type="array">
                <item name="girofeeds_productapi/general/enable" xsi:type="string">1</item>
                <item name="girofeeds_productapi/general/limit" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
